# Android Development Environment for Agent
# Part of Android Self-Healing Autonomous Agent
# Source this file: source /path/to/agent/env/android-dev.env

# Chroot root filesystem
export CHROOT_ROOT="/data/local/tmp/moto-linux-env/rootfs"

# Android SDK
export ANDROID_SDK_ROOT="/opt/android-sdk"
export ANDROID_HOME="$ANDROID_SDK_ROOT"
export PATH="$ANDROID_SDK_ROOT/cmdline-tools/latest/bin:$ANDROID_SDK_ROOT/platform-tools:$ANDROID_SDK_ROOT/build-tools/34.0.0:$PATH"

# Java
export JAVA_HOME="/usr/lib/jvm/java-17-openjdk"
export PATH="$JAVA_HOME/bin:$PATH"
# Ensure libjli.so is findable
if [[ -d "$JAVA_HOME/lib/server" ]]; then
    export LD_LIBRARY_PATH="$JAVA_HOME/lib/server:$LD_LIBRARY_PATH"
fi

# Gradle
export GRADLE_HOME="/opt/gradle"
export PATH="$GRADLE_HOME/bin:$PATH"
# Default timeouts
export GRADLE_OPTS="-Dorg.gradle.internal.http.connectionTimeout=120000 -Dorg.gradle.internal.http.socketTimeout=120000"

# Clang/LLVM
export CC=clang
export CXX=clang++
# Symlinks created by FIX-003 profile script

# Rust
export PATH="$HOME/.cargo/bin:$PATH"
export RUSTUP_HOME="$HOME/.rustup"
export CARGO_HOME="$HOME/.cargo"

# Node.js
export PATH="/usr/local/node/bin:$PATH"

# Python
export PATH="/usr/local/python/bin:$PATH"

# Go
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:/usr/local/go/bin:$PATH"

# Agent paths
export AGENT_ROOT="/storage/emulated/0/Download/AndroidHarness-CI-main/AndroidHarness-CI-main/agent"
export MEMORY_ROOT="$AGENT_ROOT/memory"
export AGENT_BIN="$AGENT_ROOT/bin"
export PATH="$AGENT_BIN:$PATH"

# KernelSU
export KERNEL_SU=true
export KSU_VERSION="$(ksud --version 2>/dev/null | head -1 || echo 'unknown')"

# Termux (if available)
if [[ -d "/data/data/com.termux/files/usr" ]]; then
    export TERMUX_PREFIX="/data/data/com.termux/files/usr"
    export PATH="$TERMUX_PREFIX/bin:$PATH"
fi

# Git
export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"

# Proxy (if needed)
# export HTTP_PROXY="http://proxy.example.com:8080"
# export HTTPS_PROXY="http://proxy.example.com:8080"
# export NO_PROXY="localhost,127.0.0.1,::1"

# Agent configuration
export AGENT_RETRY_MAX_ATTEMPTS=3
export AGENT_RETRY_BASE_DELAY=1
export AGENT_RETRY_MAX_DELAY=30
export AGENT_RETRY_SESSION_BUDGET=10
export AGENT_RETRY_FAMILY_BUDGET=3
export AGENT_RETRY_ENDPOINT_BUDGET=2
export AGENT_RETRY_ENDPOINT_WINDOW=300

# Logging
export AGENT_LOG_LEVEL="INFO"
export AGENT_LOG_DIR="$AGENT_ROOT/logs"

echo "Android development environment loaded"
echo "CHROOT_ROOT=$CHROOT_ROOT"
echo "ANDROID_SDK_ROOT=$ANDROID_SDK_ROOT"
echo "JAVA_HOME=$JAVA_HOME"
echo "AGENT_ROOT=$AGENT_ROOT"
